# Copy to .env (`cp .env.example .env`). .env is git-ignored; never commit real credentials.

# --- PostgreSQL (warehouse + Airflow metadata DB on the same server) ---
POSTGRES_USER=hiring
POSTGRES_PASSWORD=change-me-hiring
POSTGRES_DB=hiring
AIRFLOW_DB=airflow
PG_HOST=postgres
PG_PORT=5432
# Host port for connecting from your laptop (psql, DBeaver)
PG_HOST_PORT=5433

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-admin
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_WEBSERVER_SECRET_KEY=change-me-secret

# --- Paths inside the containers ---
DATA_DIR=/data
RESULTS_DIR=/opt/project/results

# --- Spark ---
# local[4] keeps the pandas-UDF Python workers (~100 MB each) inside the memory budget.
SPARK_MASTER=local[4]
SPARK_DRIVER_MEMORY=1g

# --- HTTP politeness ---
# Contact string appended to the User-Agent sent to HN / Algolia / Remotive.
HTTP_CONTACT=COMP4651 Group 14, HKUST
FIREBASE_RATE=40
ALGOLIA_RATE=10

# Remotive needs no API key; this is just the job-category filter ("" = all categories).
REMOTIVE_CATEGORY=software-dev

# --- Benchmarks ---
# Memory limit of the `bench` container (Benchmark 1). Must be below Docker Desktop's VM size.
BENCH_MEM_LIMIT=6g
